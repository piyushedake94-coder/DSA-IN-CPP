#include <iostream>
#include <vector>
using namespace std;

void DFS(int v, vector<vector<int>>& adj,
         vector<bool>& visited) {
    visited[v] = true;
    cout << v << " ";

    for (int u : adj[v]) {
        if (!visited[u]) {
            DFS(u, adj, visited);
        }
    }
}

int main() {
    int n, e;
    cout << "Enter number of charging stations: ";
    cin >> n;

    vector<vector<int>> adj(n);

    cout << "Enter number of connections: ";
    cin >> e;

    cout << "Enter connections (station1 station2):\n";
    for (int i = 0; i < e; i++) {
        int u, v;
        cin >> u >> v;

        adj[u].push_back(v);
        adj[v].push_back(u);
    }

    int start;
    cout << "Enter starting station (0 to "
         << n - 1 << "): ";
    cin >> start;

    if (start < 0 || start >= n) {
        cout << "Invalid starting station.\n";
        return 0;
    }

    vector<bool> visited(n, false);

    cout << "\nDFS traversal (reached stations): ";
    DFS(start, adj, visited);

    cout << "\nUnreachable stations: ";
    bool found = false;

    for (int i = 0; i < n; i++) {
        if (!visited[i]) {
            cout << i << " ";
            found = true;
        }
    }

    if (!found)
        cout << "None";

    cout << "\nIsolated stations: ";
    found = false;

    for (int i = 0; i < n; i++) {
        if (adj[i].empty()) {
            cout << i << " ";
            found = true;
        }
    }

    if (!found)
        cout << "None";

    cout << endl;
    return 0;
}
